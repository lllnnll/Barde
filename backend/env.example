NODE_ENV=development
PORT=3000

# Prisma reads DATABASE_URL – paste the Postgres "Prisma" or "Direct" URL here
DATABASE_URL=postgres://USER:PASS@HOST/db?sslmode=require

# Optional: keep the other URLs provided by `vercel postgres` for reference
POSTGRES_PRISMA_URL=postgres://USER:PASS@HOST/db?sslmode=require
POSTGRES_URL_NON_POOLING=postgres://USER:PASS@HOST/db?sslmode=require
POSTGRES_URL=postgres://USER:PASS@HOST/db?sslmode=require

# Uncomment to restrict CORS to a single origin (ex: your Vercel frontend)
# CORS_ALLOW_ORIGIN=https://your-frontend.vercel.app


